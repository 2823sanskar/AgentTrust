# Database

# Copy this file to backend/.env and replace placeholders only in that private file.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=300
DB_AUTO_CREATE_TABLES=true

# JWT
JWT_SECRET=your-secret-key-placeholder
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=115200

# Stellar Mainnet (uses real XLM; keep the funded secret key private)
STELLAR_SECRET_KEY=your_stellar_mainnet_secret_key
STELLAR_PUBLIC_KEY=GCPICED67VZ2VUESHTKMXZMWJJVSV4ZFULILSUQJS2GL77KBRHILDIN3
STELLAR_NETWORK=mainnet
STELLAR_HORIZON_URL=https://horizon.stellar.org
STELLAR_MAX_BASE_FEE=10000

# AI Provider
OPENROUTER_API_KEY=

# Browser Agent
BROWSER_AGENT_HEADLESS=true
BROWSER_AGENT_ACTION_TIMEOUT_MS=45000
BROWSER_AGENT_NAVIGATION_TIMEOUT_MS=60000

# Sandbox worker and remote desktop
SANDBOX_WORKER_URL=http://localhost:8001
NEXT_PUBLIC_EC2_NOVNC_URL=http://localhost:6080/vnc.html?autoplay=true

# App
APP_NAME=AgentTrust
ENVIRONMENT=production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-vercel-app.vercel.app
DEBUG=false
