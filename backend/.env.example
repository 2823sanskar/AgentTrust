# Database
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.your_project.supabase.co:5432/postgres

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Stellar Testnet
STELLAR_SECRET_KEY=your_stellar_testnet_secret_key
STELLAR_PUBLIC_KEY=your_stellar_testnet_public_key
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# AI Provider (free models only)
OPENROUTER_API_KEY=your_openrouter_api_key

# Browser Agent
BROWSER_AGENT_HEADLESS=true
BROWSER_AGENT_ACTION_TIMEOUT_MS=45000
BROWSER_AGENT_NAVIGATION_TIMEOUT_MS=60000

# Decoupled Sandbox Worker
# Local WSL2/VM: http://127.0.0.1:9000
# AWS EC2 later: http://<ec2-private-ip>:9000
# Leave blank to fallback to the backend local Docker runner.
SANDBOX_WORKER_URL=

# App
APP_NAME=AgentTrust
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEBUG=true
