FROM python:3.11-slim

WORKDIR /app

# Install Docker CLI inside the worker container so it can control an AWS host machine's Docker daemon if needed
RUN apt-get update && apt-get install -y \
    curl \
    && curl -fsSL https://get.docker.com | sh \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY worker.py .

EXPOSE 9000

ENV PYTHONUNBUFFERED=1
ENV ENVIRONMENT=production

# Run with uvicorn production flags
CMD ["uvicorn", "worker:app", "--host", "0.0.0.0", "--port", "9000", "--workers", "4"]
